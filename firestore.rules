rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Active Prompts catalog collection
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if isSignedIn(); // Safeguarded by backend token and client authorization checks
    }

    // AI Prompt Drafts System
    match /prompt_drafts/{draftId} {
      // Anyone can query/get published drafts
      allow get: if resource.data.status == "published";
      allow list: if resource.data.status == "published";

      // Administrators or authenticated authors can read all drafts
      allow read: if isSignedIn();

      // Creating drafts
      allow create: if isSignedIn() && 
        request.resource.data.status in ["draft", "published", "rejected"] &&
        request.resource.data.title is string && 
        request.resource.data.title.size() <= 300 &&
        request.resource.data.prompt is string;

      // Updating drafts
      allow update: if isSignedIn() &&
        request.resource.data.status in ["draft", "published", "rejected"] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;

      // Deleting drafts
      allow delete: if isSignedIn();
    }
  }
}
